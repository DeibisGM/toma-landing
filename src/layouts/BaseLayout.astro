---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Toma. Decide qué ver, juntos.',
  description = 'Toma guarda lo que te interesa y ayuda a tu grupo a decidir qué ver sin darle mil vueltas.',
  image = '/images/og-toma.png',
  type = 'website',
  noindex = false
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://toma.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2b66ee" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/sora.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" type="image/webp" href="/images/toma-icon.webp" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Toma" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="/site.js" defer></script>
  </body>
</html>
