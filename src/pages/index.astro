---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.slice(0, 3);

const PLAY = 'https://play.google.com/store/apps/details?id=com.app.toma';
const genres = [
  ['Terror', '#d8352a', ''], ['Comedia', '#ffd233', 'dark'], ['Anime', '#3dd9a0', 'dark'], ['K-drama', '#ff7a30', ''],
  ['Thriller', '#6a45f2', ''], ['Romance', '#ff8cc6', 'dark'], ['Ciencia ficción', '#2b66ee', ''], ['Documental', '#47b2dc', 'dark'],
  ['Animación', '#b690ff', 'dark'], ['Acción', '#d8352a', ''], ['Series', '#2b66ee', ''], ['Películas', '#ffd233', 'dark']
];
const loop = [...genres, ...genres];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero" data-pixels>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="ticket-badge"><img src="/stickers/sk_boleto.webp" alt="" width="22" height="22" /><b>Gratis en Android</b></p>
        <h1>Deja de discutir <span class="hl">qué ver.</span></h1>
        <p class="hero-lede">Guarda lo que quieres ver, ponte de acuerdo con tu gente y deja que Toma elija la película, serie o anime de esta noche.</p>
        <div class="hero-actions">
          <a class="btn btn-white btn-play" href={PLAY} rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.2 2.6c-.3.3-.5.8-.5 1.4v16c0 .6.2 1.1.5 1.4l9.2-9.4L4.2 2.6Zm10.6 10.2 2.7 2.8-11.4 6.5 8.7-9.3Zm0-1.6L6.1 1.9l11.4 6.5-2.7 2.8Zm5.3.8c.8.4.8 1.2 0 1.6l-1.9 1.1-3-3.1 3-3 1.9 1.1c.7.4.7 1.1 0 1.5l0 .8Z"/></svg>
            <span><small>Disponible en</small><span>Google Play</span></span>
          </a>
          <a class="btn btn-ghost" href="#como-funciona">Ver cómo funciona</a>
        </div>
        <div class="hero-proof">
          <span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6L12 2Z"/></svg>Películas, series y anime</span>
          <span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6L12 2Z"/></svg>En español, inglés, portugués, francés y coreano</span>
        </div>
      </div>
      <div class="hero-stage">
        <img class="stk stk-a" src="/stickers/sk_palomitas.webp" alt="" width="118" height="118" />
        <img class="stk stk-b" src="/stickers/sk_estrella.webp" alt="" width="96" height="96" />
        <img class="stk stk-c" src="/stickers/sk_claqueta.webp" alt="" width="110" height="110" />
        <img class="stk stk-d" src="/stickers/sk_boleto.webp" alt="" width="90" height="90" />
        <div class="float-chip chip-match"><i>✓</i> Ya se pusieron de acuerdo</div>
        <div class="float-chip chip-vote"><i>3</i> amigos dijeron «Quiero»</div>
        <PhoneFrame class="phone-hero" src="/images/shot-resultado.png" alt="Toma recomienda 3 opciones: Al filo del mañana, Blade Runner 2049 y Estación Zombie" priority />
      </div>
    </div>
  </section>
  <div class="scallop" aria-hidden="true"></div>

  <!-- GÉNEROS -->
  <section class="marquee" aria-label="Lo que puedes guardar en Toma">
    <div class="marquee-track" aria-hidden="true">
      {loop.map(([name, color, ink]) => <span class={`genre ${ink}`} style={`background:${color}`}>{name}</span>)}
    </div>
  </section>

  <!-- MANIFIESTO -->
  <section class="manifesto wrap" data-reveal>
    <img class="stk m1" src="/stickers/sk_sofa.webp" alt="" width="96" height="96" loading="lazy" />
    <img class="stk m2" src="/stickers/sk_corazon.webp" alt="" width="84" height="84" loading="lazy" />
    <img class="stk m3" src="/stickers/sk_play.webp" alt="" width="76" height="76" loading="lazy" />
    <h2>Pasas más tiempo <span class="strike">eligiendo</span> que <em>viendo.</em><br />Eso se acaba hoy.</h2>
    <p>Toma junta tu lista, tus gustos y los de tus amigos en un solo lugar. Tú pones las ganas de ver algo; ella pone la decisión.</p>
  </section>

  <!-- FUNCIONES -->
  <section class="bento-section wrap" id="funciones">
    <div class="section-head" data-reveal>
      <span class="kicker">Todo en una app</span>
      <h2>Pensada para la noche de «¿y qué vemos?»</h2>
    </div>
    <div class="bento">
      <article class="tile t-list has-shot" data-reveal>
        <span class="tag">Tu lista</span>
        <h3>Todo lo que quieres ver, en un solo lugar.</h3>
        <p>Por ver, viendo y visto. Películas, series y anime ordenados como tú quieras.</p>
        <div class="shot"><PhoneFrame src="/images/shot-home.png" alt="Mi lista en Toma con la sección Por ver" /></div>
      </article>

      <article class="tile t-groups has-shot" data-reveal>
        <span class="tag">Grupos</span>
        <h3>Decidan juntos, sin discutir.</h3>
        <p>Crea un grupo, invita a tus amigos y cada quien propone. Toma encuentra el punto medio.</p>
        <div class="shot"><PhoneFrame src="/images/shot-groups.png" alt="Pantalla de grupos en Toma" /></div>
        <img class="stk" src="/stickers/sk_globo.webp" alt="" width="96" height="96" style="right: 26px; top: 26px; width: 92px; transform: rotate(10deg)" loading="lazy" />
      </article>

      <article class="tile t-vote" data-reveal>
        <span class="tag">La elección de hoy</span>
        <h3>Un boleto con la mejor opción.</h3>
        <p>Cada quien vota y el grupo gana una sola película.</p>
        <div class="mini-ticket">
          <b>Madre siniestra · 2026</b>
          <div class="vote-row" role="group" aria-label="Prueba votar">
            <button class="vote-btn" type="button" aria-pressed="true">Quiero</button>
            <button class="vote-btn" type="button" aria-pressed="false">Da igual</button>
            <button class="vote-btn" type="button" aria-pressed="false">Paso</button>
          </div>
        </div>
      </article>

      <article class="tile t-pick" data-reveal>
        <span class="tag">A tu medida · Premium</span>
        <h3>Cuéntale qué te late.</h3>
        <p>Escribe o dicta cómo quieres sentirte y te da 3 opciones.</p>
        <div class="moods" role="group" aria-label="Prueba elegir un ánimo">
          <button class="mood" type="button" aria-pressed="true">Reír</button>
          <button class="mood" type="button" aria-pressed="false">Adrenalina</button>
          <button class="mood" type="button" aria-pressed="false">Miedo</button>
          <button class="mood" type="button" aria-pressed="false">Relajarme</button>
          <button class="mood" type="button" aria-pressed="false">Romance</button>
        </div>
        <img class="stk stk-mini" src="/stickers/sk_microfono.webp" alt="" width="120" height="120" loading="lazy" />
      </article>

      <article class="tile t-detail has-shot" data-reveal>
        <span class="tag">Fichas con color</span>
        <h3>Cada título se siente distinto.</h3>
        <p>Tráiler, reparto, dónde verla y más.</p>
        <div class="shot" style="width: min(72%, 230px)"><PhoneFrame src="/images/shot-detail.png" alt="Ficha de una película en Toma" /></div>
      </article>

      <article class="tile t-wide t-mint" data-reveal>
        <span class="tag">Afinidad</span>
        <h3>Sabe qué te va a gustar.</h3>
        <p>Cada título trae un porcentaje de afinidad contigo, que mejora con cada nota que pones.</p>
        <div class="affinity"><span class="pct">92%</span><span class="bar"><i></i></span></div>
      </article>

      <article class="tile t-wide t-sky" data-reveal>
        <span class="tag">Dónde ver</span>
        <h3>Sabes dónde verla antes de empezar.</h3>
        <p>Plataformas para ver, alquilar o comprar según tu país, y avisos cuando algo se estrena.</p>
        <div class="platforms"><span>Streaming</span><span>Alquiler</span><span>Compra</span><span>Estrenos</span></div>
        <img class="stk" src="/stickers/sk_campana.webp" alt="" width="110" height="110" style="right: 20px; bottom: 16px; width: 104px; transform: rotate(-10deg)" loading="lazy" />
      </article>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="how wrap" id="como-funciona">
    <div class="section-head" data-reveal>
      <span class="kicker">Así de fácil</span>
      <h2>De «¿qué vemos?» a <span style="color: var(--sun)">dale play</span> en tres pasos.</h2>
    </div>
    <div class="how-list">
      <div class="how-step" data-reveal>
        <span class="how-num">1</span>
        <div><h3>Guarda lo que te llama</h3><p>Agrégalo a tu lista en un toque desde cualquier título.</p></div>
        <img src="/stickers/sk_lista.webp" alt="" width="130" height="130" loading="lazy" />
      </div>
      <div class="how-step" data-reveal>
        <span class="how-num">2</span>
        <div><h3>Invita a tu gente</h3><p>Crea un grupo, comparte el enlace y cada quien propone lo suyo.</p></div>
        <img src="/stickers/sk_globo.webp" alt="" width="130" height="130" loading="lazy" />
      </div>
      <div class="how-step" data-reveal>
        <span class="how-num">3</span>
        <div><h3>Elijan y a disfrutar</h3><p>Voten «Quiero», «Da igual» o «Paso» y Toma saca la opción que gana.</p></div>
        <img src="/stickers/sk_palomitas.webp" alt="" width="130" height="130" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- A TU MEDIDA -->
  <section class="medida" id="a-tu-medida" data-pixels="1">
    <div class="wrap medida-grid">
      <div class="medida-copy" data-reveal>
        <p class="ticket-badge"><img src="/stickers/sk_boleto.webp" alt="" width="22" height="22" /><b>Premium</b></p>
        <h2>Dile qué te late. Toma te da 3.</h2>
        <p class="lede">Nada de scrollear por media hora. Cuéntale con tus palabras, o dictando, qué tienes ganas de ver.</p>
        <ul class="checks">
          <li>«Algo oscuro tipo Black Mirror, pero con humor»</li>
          <li>Cada opción llega con una sinopsis, no con elogios vacíos</li>
          <li>Nunca te sugiere lo que ya viste, guardaste o calificaste</li>
        </ul>
        <a class="btn btn-white" href={PLAY} rel="noreferrer">Pruébalo en Toma</a>
      </div>
      <div class="medida-stage" data-reveal>
        <PhoneFrame class="p1" src="/images/shot-medida.png" alt="Pantalla A tu medida con ánimos para elegir" />
        <PhoneFrame class="p2" src="/images/shot-resultado.png" alt="Resultado de A tu medida con 3 películas" />
      </div>
    </div>
  </section>
  <div class="scallop" aria-hidden="true"></div>

  <!-- PREMIUM -->
  <section class="premium wrap" id="premium">
    <div class="premium-card" data-reveal>
      <div>
        <p class="ticket-badge"><img src="/stickers/sk_boleto.webp" alt="" width="22" height="22" /><b>Toma Premium</b></p>
        <h2>Para quienes se toman <em>en serio</em> su noche de cine.</h2>
        <p class="lede">Toma es gratis para empezar. Premium agrega las funciones más inteligentes cuando las quieras.</p>
        <div class="hero-actions"><a class="btn" href={PLAY} rel="noreferrer">Descargar Toma</a></div>
      </div>
      <div class="premium-list">
        <div class="pfeat"><img src="/stickers/sk_lupa.webp" alt="" loading="lazy" /><b>Describir</b><span>Busca una peli por lo que recuerdas de ella.</span></div>
        <div class="pfeat"><img src="/stickers/sk_cohete.webp" alt="" loading="lazy" /><b>A tu medida</b><span>3 opciones según tu ánimo del momento.</span></div>
        <div class="pfeat"><img src="/stickers/sk_lista.webp" alt="" loading="lazy" /><b>Listas inteligentes</b><span>Tu lista se ordena sola con tus gustos.</span></div>
        <div class="pfeat"><img src="/stickers/sk_destello.webp" alt="" loading="lazy" /><b>Tu receta</b><span>Los 3 mejores títulos según tus gustos.</span></div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="blog-preview wrap" data-reveal>
    <div class="blog-heading">
      <div><span class="kicker">Desde la cabina</span><h2>Historias para ver<br />y conversar.</h2></div>
      <a class="text-link" href="/blog/">Ver todo el blog →</a>
    </div>
    <div class="blog-grid">
      {latestPosts.map((post) => <BlogCard post={post} featured={post.id === featuredPost?.id} />)}
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="faq-block wrap" id="preguntas" data-reveal>
    <div class="faq-layout">
      <div>
        <span class="kicker">Preguntas</span>
        <h2>Lo que todos preguntan.</h2>
        <p class="lede">¿Falta algo? Escríbenos y lo añadimos.</p>
      </div>
      <div class="faq-list">
        <details open><summary>¿Toma es gratis?</summary><p>La descarga y las funciones principales son gratuitas. Algunas funciones avanzadas forman parte de Toma Premium.</p></details>
        <details><summary>¿Dónde puedo descargarla?</summary><p>Está disponible para Android en <a href={PLAY} rel="noreferrer">Google Play</a>.</p></details>
        <details><summary>¿Necesito un grupo para usarla?</summary><p>No. Usa tu lista personal desde el primer momento y crea grupos solo cuando quieras decidir en compañía.</p></details>
        <details><summary>¿De dónde salen las películas y series?</summary><p>Toma consulta catálogos de entretenimiento para mostrar títulos, imágenes y detalles. La disponibilidad puede variar por país.</p></details>
        <details><summary>¿Puedo borrar mi cuenta?</summary><p>Sí, desde la app o con los pasos de <a href="/borrar-cuenta/">borrar cuenta</a>.</p></details>
      </div>
    </div>
  </section>

  <!-- DESCARGA -->
  <section class="download" id="descarga" data-pixels="2">
    <div class="wrap" data-reveal>
      <img class="mascot" src="/images/toma-mascota.webp" alt="Palomitas, claqueta, boleto y estrella: la mascota de Toma" width="420" height="236" loading="lazy" />
      <h2>Tu próxima noche de cine empieza aquí.</h2>
      <p>Descarga Toma y deja que decidir sea la parte fácil.</p>
      <div class="hero-actions">
        <a class="btn btn-white btn-play" href={PLAY} rel="noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.2 2.6c-.3.3-.5.8-.5 1.4v16c0 .6.2 1.1.5 1.4l9.2-9.4L4.2 2.6Zm10.6 10.2 2.7 2.8-11.4 6.5 8.7-9.3Zm0-1.6L6.1 1.9l11.4 6.5-2.7 2.8Zm5.3.8c.8.4.8 1.2 0 1.6l-1.9 1.1-3-3.1 3-3 1.9 1.1c.7.4.7 1.1 0 1.5l0 .8Z"/></svg>
          <span><small>Disponible en</small><span>Google Play</span></span>
        </a>
      </div>
      <small>Android 8.0 o superior</small>
    </div>
  </section>
</BaseLayout>
