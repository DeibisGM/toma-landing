---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import titles from '../data/titles.json';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);

const PLAY = 'https://play.google.com/store/apps/details?id=com.app.toma';

// Títulos reales de TMDB (src/data/titles.json, generado con la tendencia de la semana).
type Title = (typeof titles)[number];
const t = (name: string): Title => {
  const found = titles.find((x) => x.title.startsWith(name));
  if (!found) throw new Error(`Título no encontrado en titles.json: ${name}`);
  return found;
};
const skip = ['Jimmy Kimmel Live!', 'Primetime'];
const pool = titles.filter((x) => !skip.includes(x.title));
const trending = pool.slice(0, 6);
const rowA = pool.filter((_, i) => i % 2 === 0);
const rowB = pool.filter((_, i) => i % 2 === 1);
const spotlight = titles.filter((x) => x.backdrop);

const statement = [
  { w: 'Pasas' }, { w: 'más' }, { w: 'tiempo' }, { posters: [t('La Odisea'), t('Godzilla'), t('Wildwood')] }, { w: 'eligiendo' }, { w: 'que' }, { w: 'viendo.' },
  { w: 'Toma' }, { w: 'decide' }, { w: 'contigo' }, { w: 'y' }, { w: 'con' }, { w: 'tus' }, { w: 'amigos.' }, { avatars: true }
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-pixels" data-pixels="0" data-tint="91,143,249" data-alpha="0.14" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <span class="pill"><Icon name="google-play-logo" weight="fill" />Gratis en Android</span>
      <h1>Deja de discutir <span class="line-2">qué ver esta noche.</span></h1>
      <p class="hero-lede">Guarda lo que quieres ver y decídelo con tu gente.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={PLAY} rel="noreferrer"><Icon name="googleplay" weight="fill" />Descargar en Google Play</a>
        <a class="btn btn-ghost" href="#funciones">Ver funciones</a>
      </div>
    </div>

    <div class="stage" data-stage>
      <img class="card-poster p-l3" src={t('La Odisea').poster} alt={`Póster de ${t('La Odisea').title}`} width="300" height="450" />
      <img class="card-poster p-l2" src={t('Godzilla').poster} alt={`Póster de ${t('Godzilla').title}`} width="300" height="450" />
      <PhoneFrame class="p-l1" src="/images/shot-lista.webp" alt="Mi lista en Toma con 10 títulos por ver" eager />
      <PhoneFrame class="p-c" src="/images/shot-pick.webp" alt="Elección de hoy del grupo: Madre siniestra, con los votos Quiero, Da igual y Paso" priority />
      <PhoneFrame class="p-r1" src="/images/shot-ficha.webp" alt="Ficha de Spider-Man: A través del Spider-Verso con afinidad y dónde verla" eager />
      <img class="card-poster p-r2" src={t('Dexter').poster} alt={`Póster de ${t('Dexter').title}`} width="300" height="450" />
      <img class="card-poster p-r3" src={t('Wildwood').poster} alt={`Póster de ${t('Wildwood').title}`} width="300" height="450" />
      <div class="stage-fade"></div>
    </div>
  </section>

  <!-- MANIFIESTO -->
  <section class="section-sm wrap">
    <div class="statement">
      <h2 data-words>
        {statement.map((s) => s.posters ? (
          <span class="w inline-posters" aria-hidden="true">{s.posters.map((p) => <img src={p.poster} alt="" width="300" height="450" loading="lazy" />)}</span>
        ) : s.avatars ? (
          <span class="w inline-avatars" aria-hidden="true"><i style="background:#5b8ff9">A</i><i style="background:#ffd233">L</i><i style="background:#3dd9a0">M</i></span>
        ) : <span class="w">{s.w}</span>)}
      </h2>
    </div>
  </section>

  <!-- FUNCIONES -->
  <section class="section wrap" id="funciones">
    <div class="section-head" data-reveal>
      <span class="kicker"><Icon name="sparkle" weight="fill" />Funciones</span>
      <h2>Todo para la noche de «¿y qué vemos?»</h2>
    </div>

    <div class="features">
      <article class="feature" style="--c1:#7a55ff;--c2:#5530d9" data-reveal>
        <div class="fv" data-pixels="1" data-alpha="0.12">
          <img class="fv-poster fp-1" src={t('Spider-Man').poster} alt="" width="300" height="450" loading="lazy" />
          <img class="fv-poster fp-2" src={t('La emperatriz divorciada').poster} alt="" width="300" height="450" loading="lazy" />
          <PhoneFrame class="fv-phone" src="/images/shot-lista.webp" alt="Mi lista en Toma" />
          <div class="toast"><Icon name="bookmark" weight="fill" /><span>Guardada en <b>Por ver</b></span></div>
        </div>
        <div class="fc">
          <h3><Icon name="bookmark" weight="fill" />Tu lista</h3>
          <p>Películas, series y anime en un solo lugar.</p>
        </div>
      </article>

      <article class="feature" style="--c1:#3b78ff;--c2:#1e4fd6" data-reveal>
        <div class="fv center" data-pixels="2" data-alpha="0.12">
          <div class="ticket">
            <div class="ticket-top">
              <img src={t('Madre siniestra').poster} alt={`Póster de ${t('Madre siniestra').title}`} width="300" height="450" loading="lazy" />
              <div>
                <span class="ticket-badge"><Icon name="star" weight="fill" />Mejor opción</span>
                <h4>Madre siniestra</h4>
                <p class="ticket-sub">2026 · Película</p>
                <span class="ticket-play"><Icon name="play" weight="fill" />Ver ahora</span>
              </div>
            </div>
            <div class="ticket-cut"></div>
            <div class="vote-row" role="group" aria-label="Prueba a votar" data-autovote>
              <button class="vote-btn" type="button" aria-pressed="true"><Icon name="thumbUp" weight="fill" />Quiero</button>
              <button class="vote-btn" type="button" aria-pressed="false"><Icon name="equal" />Da igual</button>
              <button class="vote-btn" type="button" aria-pressed="false"><Icon name="thumbDown" weight="fill" />Paso</button>
            </div>
          </div>
        </div>
        <div class="fc">
          <h3><Icon name="ticket" weight="fill" />La elección de hoy</h3>
          <p>Cada quien vota. Gana una sola.</p>
        </div>
      </article>

      <article class="feature third" style="--c1:#3dd9a0;--c2:#16a874" data-reveal>
        <div class="fv center">
          <div class="mini-card">
            <div class="mini-head"><b>Cine de viernes</b><span class="avatars" aria-hidden="true"><i style="background:#5b8ff9">A</i><i style="background:#ffd233">L</i><i style="background:#b690ff">M</i><i style="background:#ff8cc6">J</i></span></div>
            {[t('Godzilla'), t('Street Fighter'), t('Resident Evil')].map((p, i) => (
              <div class="mini-row"><img src={p.poster} alt="" width="300" height="450" loading="lazy" /><span><b>{p.title}</b><small>{p.year} · {p.kind}</small></span><em><Icon name="thumbUp" weight="fill" /><span data-count={[4, 3, 1][i]}>{[4, 3, 1][i]}</span></em></div>
            ))}
          </div>
        </div>
        <div class="fc">
          <h3><Icon name="users" weight="fill" />Grupos</h3>
          <p>Cada quien propone lo suyo.</p>
        </div>
      </article>

      <article class="feature third" style="--c1:#ff8a45;--c2:#f05a12" data-reveal>
        <div class="fv center">
          <div class="mini-card">
            {[[t('VisionQuest'), 94], [t('La Odisea'), 87], [t('Ebenezer'), 72]].map(([p, v]) => (
              <div class="mini-row aff"><img src={(p as Title).poster} alt="" width="300" height="450" loading="lazy" /><span><b>{(p as Title).title}</b><span class="bar"><i style={`--v:${v}%`}></i></span></span><em class="pct"><span data-count={v}>{v}</span>%</em></div>
            ))}
          </div>
        </div>
        <div class="fc">
          <h3><Icon name="gauge" weight="fill" />Afinidad</h3>
          <p>Sabe qué te va a gustar.</p>
        </div>
      </article>

      <article class="feature third" style="--c1:#ff8cc6;--c2:#e9559f" data-reveal>
        <div class="fv center">
          <div class="where">
            <div class="where-poster"><img src={t('Clayface').poster} alt="" width="300" height="450" loading="lazy" /><span><b>Clayface</b><small>Se estrena pronto</small></span></div>
            <div class="where-row"><Icon name="television-simple" weight="fill" /><span>Suscripción</span><small>Incluida</small></div>
            <div class="where-row alert"><Icon name="bell" weight="fill" /><span>Avísame del estreno</span><i class="switch on"></i></div>
          </div>
        </div>
        <div class="fc">
          <h3><Icon name="tv" weight="fill" />Dónde ver</h3>
          <p>Plataformas y avisos de estreno.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- DESCUBRE -->
  <section class="cinema" id="descubre" data-spot>
    <div class="cinema-bg" aria-hidden="true">
      {spotlight.map((s, i) => <img class:list={[{ on: i === 0 }]} src={s.backdrop} alt="" width="1920" height="1080" loading="lazy" />)}
    </div>
    <div class="wrap cinema-inner">
      <div class="cinema-copy">
        <span class="kicker on-dark"><Icon name="compass" weight="fill" />Descubre · Para hoy</span>
        <div class="spot-titles">
          {spotlight.map((s, i) => (
            <div class:list={['spot-title', { on: i === 0 }]}>
              <h2>{s.title}</h2>
              <p>{s.year} · {s.kind} · {s.genres.filter(Boolean).join(' · ')} <span class="star"><Icon name="star" weight="fill" />{s.rating.toFixed(1)}</span></p>
            </div>
          ))}
        </div>
        <div class="spot-actions">
          <span class="btn btn-primary"><Icon name="bookmark" weight="fill" />Guardar</span>
          <span class="btn btn-glass"><Icon name="play" weight="fill" />Tráiler</span>
        </div>
      </div>
      <div class="cinema-picker" role="tablist" aria-label="Títulos destacados">
        {spotlight.map((s, i) => (
          <button class:list={['pick', { on: i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={s.title} data-i={i}>
            <img src={s.poster} alt="" width="300" height="450" loading="lazy" />
            <span class="pick-bar"><i></i></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap trend-wrap">
    <h3 class="trend-head" data-reveal><Icon name="fire" weight="fill" />Tendencias de la semana</h3>
    <div class="trend" data-reveal>
      {trending.map((p, i) => (
        <figure class="trend-item">
          <div class="trend-img"><img src={p.poster} alt={`Póster de ${p.title}`} width="300" height="450" loading="lazy" /><span class="rank">{i + 1}</span><span class="save"><Icon name="bookmark" weight="fill" /></span></div>
          <figcaption><b>{p.title}</b><small>{p.year} · <Icon name="star" weight="fill" />{p.rating.toFixed(1)}</small></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- A TU MEDIDA -->
  <section class="section wrap" id="a-tu-medida">
    <div class="medida">
      <div class="medida-copy" data-reveal>
        <span class="kicker"><Icon name="crown-simple" weight="fill" />A tu medida · Premium</span>
        <h2>Dile cómo te quieres sentir. Toma te da 3.</h2>
        <div class="prompt">
          <p class="prompt-text" data-typing="Algo oscuro tipo Black Mirror, pero con humor|Una de acción para ver en pareja|Anime corto que me haga llorar">Algo oscuro tipo Black Mirror, pero con humor</p>
          <div class="prompt-foot"><span>Escribe o dicta</span><span class="mic"><Icon name="mic" weight="fill" /></span></div>
        </div>
      </div>
      <div class="medida-stage" data-pixels="1" data-reveal>
        <PhoneFrame src="/images/shot-medida.webp" alt="Pantalla A tu medida con ánimos para elegir" />
        <PhoneFrame src="/images/shot-elegir.webp" alt="Toma elige Spider-Man: Un nuevo día para ti" />
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA (franja cobalto) -->
  <section class="band" id="como-funciona" data-pixels="3" data-tint="150,200,255" data-alpha="0.22" data-cell="10">
    <div class="wrap band-inner">
      <div class="section-head center on-cobalt" data-reveal>
        <span class="kicker"><Icon name="list-checks" weight="fill" />Cómo funciona</span>
        <h2>Tres pasos y a darle play.</h2>
      </div>
      <div class="steps">
        <div class="step" data-reveal>
          <div class="step-art"><img src="/images/ui-lista.webp" alt="Sección Por ver de Mi lista" width="720" height="440" loading="lazy" /></div>
          <span class="step-num">01</span><h3>Guarda</h3><p>Lo que te llama, en un toque.</p>
        </div>
        <div class="step" data-reveal>
          <div class="step-art"><img src="/images/ui-grupos.webp" alt="Cómo va el grupo: quién ya votó" width="720" height="407" loading="lazy" /></div>
          <span class="step-num">02</span><h3>Invita</h3><p>Tu gente propone y vota.</p>
        </div>
        <div class="step" data-reveal>
          <div class="step-art"><img src="/images/ui-boleto.webp" alt="Boleto con la mejor opción del grupo" width="720" height="553" loading="lazy" /></div>
          <span class="step-num">03</span><h3>Mira</h3><p>Toma saca la que gana.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CATÁLOGO EN MOVIMIENTO -->
  <section class="section-sm wall" aria-label="Algunos títulos que puedes guardar en Toma">
    <div class="wall-row">{[...rowA, ...rowA].map((p) => <img src={p.poster} alt="" width="300" height="450" loading="lazy" />)}</div>
    <div class="wall-row reverse">{[...rowB, ...rowB].map((p) => <img src={p.poster} alt="" width="300" height="450" loading="lazy" />)}</div>
  </section>

  <!-- PREMIUM -->
  <section class="section wrap" id="premium">
    <div class="section-head" data-reveal>
      <span class="kicker"><Icon name="crown-simple" weight="fill" />Planes</span>
      <h2>Gratis para empezar.</h2>
    </div>
    <div class="plans">
      <div class="plan" data-reveal>
        <div class="plan-name"><h3>Toma</h3></div>
        <p class="plan-price">Gratis<small>para siempre</small></p>
        <ul>
          <li><Icon name="check-circle" weight="fill" />Tu lista</li>
          <li><Icon name="check-circle" weight="fill" />Grupos y votación</li>
          <li><Icon name="check-circle" weight="fill" />Afinidad y dónde ver</li>
        </ul>
        <a class="btn btn-ghost" href={PLAY} rel="noreferrer">Descargar gratis</a>
      </div>
      <div class="plan plan-premium" data-pixels="2" data-alpha="0.13" data-reveal>
        <div class="plan-name"><h3>Toma Premium</h3><span class="plan-badge"><Icon name="crown-simple" weight="fill" />Premium</span></div>
        <p class="plan-price">+4<small>funciones extra</small></p>
        <ul>
          <li><Icon name="check-circle" weight="fill" />A tu medida</li>
          <li><Icon name="check-circle" weight="fill" />Describir una peli</li>
          <li><Icon name="check-circle" weight="fill" />Listas inteligentes</li>
          <li><Icon name="check-circle" weight="fill" />Tu receta</li>
        </ul>
        <a class="btn btn-primary" href={PLAY} rel="noreferrer">Probar Premium</a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {latestPosts.length > 0 && (
    <section class="section wrap">
      <div class="blog-heading" data-reveal>
        <div><span class="kicker"><Icon name="article" weight="fill" />Blog</span><h2>Ideas para ver mejor.</h2></div>
        <a class="text-link" href="/blog/">Ver todo <Icon name="arrow" /></a>
      </div>
      <div class="blog-grid">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  )}

  <!-- PREGUNTAS -->
  <section class="section wrap" id="preguntas">
    <div class="faq-layout">
      <div data-reveal>
        <span class="kicker"><Icon name="question" weight="fill" />Preguntas</span>
        <h2>Lo que todos preguntan.</h2>
        <a class="text-link faq-more" href="/preguntas-frecuentes/">Ver todas <Icon name="arrow" /></a>
      </div>
      <div class="faq-list" data-reveal>
        <details open><summary>¿Toma es gratis?</summary><p>Sí. Lo principal es gratis; Premium suma funciones extra.</p></details>
        <details><summary>¿Dónde la descargo?</summary><p>En <a href={PLAY} rel="noreferrer">Google Play</a>, para Android 8.0 o superior.</p></details>
        <details><summary>¿Necesito un grupo?</summary><p>No. Tu lista funciona sola; los grupos son para decidir en compañía.</p></details>
        <details><summary>¿Puedo borrar mi cuenta?</summary><p>Sí, desde la app o en <a href="/borrar-cuenta/">borrar cuenta</a>.</p></details>
      </div>
    </div>
  </section>

  <!-- DESCARGA (franja cobalto) -->
  <section class="band band-cta" id="descarga" data-pixels="3" data-tint="150,200,255" data-alpha="0.22" data-cell="10">
    <div class="wrap band-inner cta-inner" data-reveal>
      <img class="cta-logo" src="/images/toma-logo.webp" alt="" width="72" height="77" loading="lazy" />
      <h2>Tu próxima noche de cine empieza aquí.</h2>
      <div class="hero-actions">
        <a class="btn btn-primary" href={PLAY} rel="noreferrer"><Icon name="googleplay" weight="fill" />Descargar en Google Play</a>
      </div>
      <small>Gratis · Android 8.0 o superior</small>
    </div>
  </section>
</BaseLayout>
