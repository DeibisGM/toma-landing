---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon from '../components/Icon.astro';
import titles from '../data/titles.json';

const PLAY = 'https://play.google.com/store/apps/details?id=com.app.toma';

// Títulos reales de TMDB (src/data/titles.json).
const t = (name: string) => {
  const found = titles.find((x) => x.title.startsWith(name));
  if (!found) throw new Error(`Título no encontrado en titles.json: ${name}`);
  return found;
};
const stickerL = t('La Odisea');
const stickerR = t('Godzilla');

const features = [
  {
    tag: 'Descubre y guarda',
    title: 'Todo lo que quieres ver, en un solo lugar.',
    text: 'Películas, series y anime. Tendencias y una recomendación para hoy; guarda lo que te llame en un toque.',
    shot: '/images/shot-explorar.webp',
    alt: 'Pantalla Explorar con la recomendación Para hoy y las tendencias'
  },
  {
    tag: 'Grupos',
    title: 'Cada quien vota. Gana una sola.',
    text: 'Crea un grupo, cada uno propone lo suyo y Toma saca la elección de hoy. Sin discutir.',
    shot: '/images/shot-pick.webp',
    alt: 'Elección de hoy del grupo Cine de viernes: Madre siniestra, con los votos Quiero, Da igual y Paso'
  },
  {
    tag: 'Afinidad y dónde ver',
    title: 'Sabe qué te va a gustar y dónde está.',
    text: 'Un porcentaje de afinidad para cada título y la plataforma donde verlo, con aviso de estrenos.',
    shot: '/images/shot-ficha.webp',
    alt: 'Ficha de Spider-Man: A través del Spider-Verso con 61% de afinidad y disponible en Netflix'
  }
];

const steps = [
  ['Guarda', 'Lo que te llama la atención, en un toque.'],
  ['Invita', 'Tu gente se une al grupo y propone.'],
  ['Mira', 'Todos votan y Toma elige la ganadora.']
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero-copy panel panel-soft">
      <h1>Deja de discutir qué ver esta noche.</h1>
      <p class="lede">Toma guarda lo que quieres ver y te ayuda a decidirlo con tu gente.</p>
      <div class="actions">
        <a class="btn btn-dark" href={PLAY} rel="noreferrer"><Icon name="googleplay" weight="fill" />Descargar gratis</a>
      </div>
      <p class="hero-note">Gratis en Android</p>
    </div>
    <div class="hero-art panel panel-sun">
      <img class="sticker sticker-l" src={stickerL.poster} alt="" width="300" height="450" />
      <img class="sticker sticker-r" src={stickerR.poster} alt="" width="300" height="450" />
      <PhoneFrame class="hero-phone" src="/images/shot-lista.webp" alt="Mi lista en Toma con 10 títulos por ver" priority />
    </div>
  </section>

  <!-- FUNCIONES -->
  <section class="wrap section" id="funciones">
    <div class="section-head">
      <p class="tag">Funciones</p>
      <h2>Menos tiempo eligiendo, más tiempo viendo.</h2>
    </div>

    <div class="rows">
      {features.map((f, i) => (
        <article class:list={['row', { flip: i % 2 === 1 }]} data-reveal>
          <div class="row-copy">
            <p class="tag">{f.tag}</p>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
          <div class="row-art panel panel-soft">
            <PhoneFrame src={f.shot} alt={f.alt} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- A TU MEDIDA -->
  <section class="wrap section" id="a-tu-medida">
    <div class="medida panel panel-cobalt" data-reveal>
      <div class="medida-copy">
        <p class="tag tag-light"><Icon name="crown-simple" weight="fill" />Premium</p>
        <h2>Dile cómo te quieres sentir. Toma te da 3.</h2>
        <p>Escribe o dicta algo como «algo oscuro tipo Black Mirror, pero con humor» y recibe tres opciones pensadas para ti.</p>
      </div>
      <div class="medida-art">
        <PhoneFrame src="/images/shot-medida.webp" alt="Pantalla A tu medida: ¿Qué tienes ganas de ver?" />
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="wrap section" id="como-funciona">
    <div class="section-head">
      <p class="tag">Cómo funciona</p>
      <h2>Tres pasos y a darle play.</h2>
    </div>
    <ol class="steps">
      {steps.map(([title, text], i) => (
        <li data-reveal>
          <span class="step-num">{i + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- PLANES -->
  <section class="wrap section" id="premium">
    <div class="section-head">
      <p class="tag">Planes</p>
      <h2>Gratis para empezar.</h2>
    </div>
    <div class="plans">
      <div class="plan panel panel-soft" data-reveal>
        <h3>Toma</h3>
        <p class="plan-price">Gratis</p>
        <ul>
          <li><Icon name="check" />Tu lista</li>
          <li><Icon name="check" />Grupos y votación</li>
          <li><Icon name="check" />Afinidad y dónde ver</li>
        </ul>
        <a class="btn btn-light" href={PLAY} rel="noreferrer">Descargar gratis</a>
      </div>
      <div class="plan panel panel-cobalt" data-reveal>
        <h3>Toma Premium</h3>
        <p class="plan-price">Todo lo anterior, y más</p>
        <ul>
          <li><Icon name="check" />A tu medida</li>
          <li><Icon name="check" />Describir una peli</li>
          <li><Icon name="check" />Listas inteligentes</li>
          <li><Icon name="check" />Tu receta</li>
        </ul>
        <a class="btn btn-sun" href={PLAY} rel="noreferrer">Probar Premium</a>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="wrap section" id="preguntas">
    <div class="faq-layout">
      <div class="section-head">
        <p class="tag">Preguntas</p>
        <h2>Lo que todos preguntan.</h2>
        <a class="text-link" href="/preguntas-frecuentes/">Ver todas <Icon name="arrow" /></a>
      </div>
      <div class="faq-list">
        <details open><summary>¿Toma es gratis?</summary><p>Sí. Lo principal es gratis; Premium suma funciones extra.</p></details>
        <details><summary>¿Dónde la descargo?</summary><p>En <a href={PLAY} rel="noreferrer">Google Play</a>, para Android 8.0 o superior.</p></details>
        <details><summary>¿Necesito un grupo?</summary><p>No. Tu lista funciona sola; los grupos son para decidir en compañía.</p></details>
        <details><summary>¿Puedo borrar mi cuenta?</summary><p>Sí, desde la app o en <a href="/borrar-cuenta/">borrar cuenta</a>.</p></details>
      </div>
    </div>
  </section>

  <!-- DESCARGA -->
  <section class="wrap section" id="descarga">
    <div class="cta panel panel-sun" data-reveal>
      <img class="cta-logo" src="/images/toma-logo.webp" alt="" width="72" height="77" loading="lazy" />
      <h2>Tu próxima noche de cine empieza aquí.</h2>
      <a class="btn btn-dark" href={PLAY} rel="noreferrer"><Icon name="googleplay" weight="fill" />Descargar en Google Play</a>
      <small>Gratis · Android 8.0 o superior</small>
    </div>
  </section>
</BaseLayout>
