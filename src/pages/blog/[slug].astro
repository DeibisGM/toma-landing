---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

import { coverFor } from '../../lib/covers';
const { post } = Astro.props;
const cover = coverFor(post.data.category);
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Toma`} description={post.data.description} image={post.data.image} type="article">
  <article class="article-page section-wrap">
    <header class="article-header" data-reveal>
      <a class="back-link" href="/blog/">← Volver al blog</a>
      <div class="blog-meta"><span>{post.data.category}</span><span>{post.data.readTime}</span></div>
      <h1>{post.data.title}</h1>
      <p class="article-lede">{post.data.description}</p>
      <div class="article-byline"><span>{post.data.author}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time></div>
    </header>
    <div class="article-cover" data-reveal data-pixels style={`background:${cover.bg}`}><img src={cover.sticker} alt="" width="220" height="220" /></div>
    <div class="article-content prose"><Content /></div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.image, Astro.site ?? 'https://toma.app').toString(),
    datePublished: post.data.pubDate.toISOString(),
    author: { '@type': 'Organization', name: post.data.author }
  })} />
</BaseLayout>
