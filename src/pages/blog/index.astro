---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog | Toma" description="Noticias, ideas y recomendaciones para elegir mejor qué ver.">
  <section class="page-hero section-wrap" data-reveal>
    <p class="eyebrow"><span class="eyebrow-line"></span> Blog</p>
    <h1>Novedades y <em>recomendaciones.</em></h1>
    <p>Lo nuevo de Toma y listas de películas y series para ver.</p>
  </section>
  <section class="blog-list section-wrap">
    <div class="blog-list-header"><span>{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}</span></div>
    <div class="blog-grid blog-grid-large">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</BaseLayout>
