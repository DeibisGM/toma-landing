---
const PLAY = 'https://play.google.com/store/apps/details?id=app.toma.mobile';
const path = Astro.url.pathname;
const links = [
  ['/#funciones', 'Funciones'],
  ['/#como-funciona', 'Cómo funciona'],
  ['/preguntas-frecuentes/', 'Preguntas'],
  ['/blog/', 'Blog']
];
---

<header class="site-header" data-header>
  <div class="nav-capsule">
    <a class="brand" href="/" aria-label="Toma, inicio">
      <img src="/images/toma-logo.webp" alt="" width="28" height="30" />
      <span>Toma</span>
    </a>
    <nav id="site-menu" class="site-nav" data-menu aria-label="Principal">
      {links.map(([href, label]) => <a href={href} aria-current={href === '/blog/' && path.startsWith('/blog') ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="btn btn-primary btn-small" href={PLAY} rel="noreferrer">Descargar</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir menú" data-menu-button>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>
