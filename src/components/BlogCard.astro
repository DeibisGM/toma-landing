---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      image: string;
      readTime: string;
    };
  };
}

const { post } = Astro.props;
import { coverStyle } from "../lib/covers";
const href = `/blog/${post.id}/`;
// Las capturas de la app se muestran dentro de un marco de teléfono; cualquier otra imagen cubre la portada.
const isShot = post.data.image.includes('/images/shot-');
---

<article class="blog-card" data-reveal>
  <a class:list={['blog-image', { 'is-photo': !isShot }]} style={coverStyle(post.data.category)} href={href} aria-label={`Leer ${post.data.title}`}>
    <img src={post.data.image} alt="" width="720" height="1600" loading="lazy" decoding="async" />
  </a>
  <div class="blog-card-body">
    <div class="blog-meta"><span>{post.data.category}</span><span>{post.data.readTime}</span></div>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
  </div>
</article>
