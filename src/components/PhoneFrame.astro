---
import Icon from './Icon.astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  /** Imagen principal de la página (LCP). */
  priority?: boolean;
  /** Cargar sin esperar al scroll (visible al abrir la página). */
  eager?: boolean;
}

const { src, alt, class: className = '', priority = false, eager = false } = Astro.props;
---

<div class={`phone ${className}`}>
  <div class="screen">
    <!-- Barra de estado: las capturas empiezan en la barra superior de la app y el redondeado la cortaba -->
    <div class="status" aria-hidden="true">
      <span>9:41</span>
      <i class="cam"></i>
      <span class="sys"><Icon name="cell-signal-full" weight="fill" /><Icon name="wifi-high" weight="fill" /><Icon name="battery-full" weight="fill" /></span>
    </div>
    <img src={src} alt={alt} width="720" height="1533" loading={priority || eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
  </div>
</div>
