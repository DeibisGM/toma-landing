---
interface Props {
  src: string;
  alt: string;
  class?: string;
  priority?: boolean;
}

const { src, alt, class: className = '', priority = false } = Astro.props;
---

<div class={`phone ${className}`}>
  <img src={src} alt={alt} width="540" height="1200" loading={priority ? 'eager' : 'lazy'} decoding="async" />
</div>
